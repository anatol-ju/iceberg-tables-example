{
  "name": "iceberg-tables-example",
  "version": "1.1.0",
  "engines": {
    "npm": ">=10.2.4 <11.0.0",
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "ls": "cdk ls -c env=dev",
    "synth": "cdk synth -c env=dev",
    "diff": "cdk diff -c env=dev --no-change-set",
    "deploy:dev": "cdk deploy -c env=dev --profile example-dev --require-approval never --all",
    "deploy:qa": "cdk deploy -c env=qa --profile example-qa --require-approval never --all",
    "deploy:staging": "cdk deploy -c env=staging --profile example-staging --require-approval never --all",
    "deploy:prod": "cdk deploy -c env=prod --profile example-prod --require-approval never --all",
    "deploy:local": "docker compose up -d && docker compose exec cdk bash -lc 'cdklocal bootstrap -c env=local -v' && yarn deploy:local:internal",
    "deploy:local:internal": "docker compose exec cdk cdklocal deploy --app \"npx ts-node bin/index.ts\" -c env=local --require-approval never --all --no-staging"
  },
  "packageManager": "yarn@4.9.2",
  "dependencies": {
    "@aws-cdk/aws-glue-alpha": "^2.200.1-alpha.0",
    "aws-cdk": "^2.1020.2",
    "aws-cdk-lib": "^2.200.1",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "aws-cdk-local": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "volta": {
    "node": "20.10.0",
    "yarn": "4.9.2"
  },
  "stackVersions": {
    "Bucket": "0.0.1",
    "Table": "0.0.1"
  }
}
